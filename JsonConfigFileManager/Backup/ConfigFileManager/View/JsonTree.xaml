<UserControl x:Class="ConfigFileManager.View.JsonTree"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="300">
    <DockPanel>
        <ScrollViewer DockPanel.Dock="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Close" Margin = "0 5 3 5" Click="ButtonClose_Click" />
                    <Button Content="Save" Margin = "0 5 3 5" Click="ButtonSave_Click" />
                </StackPanel>
                <StackPanel x:Name="theStack">
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
