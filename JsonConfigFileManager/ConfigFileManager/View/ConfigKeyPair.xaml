<UserControl x:Class="ConfigFileManager.View.ConfigKeyPair"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vml = "clr-namespace:ConfigFileManager.VML"
    xmlns:views="clr-namespace:ConfigFileManager.View"
    xmlns:vm="clr-namespace:ConfigFileManager.ViewModel"
    vml:ViewModelLocator.AutoHookedUpViewModel = "True"
    xmlns:toolkit="http://schemas.microsoft.com/wpf/2008/toolkit"
    Height="300"
             >
    <Grid>
        <StackPanel x:Name="TheStack">
            <StackPanel Orientation="Horizontal">
                <Button Content="Add Single" Margin = "0 5 3 5" Click="ButtonAddSingle_Click" />
                <Button Content="Add Multiple" Margin = "0 5 3 5" Click="ButtonAddMultiple_Click" />
                <Button Content="Delete" Margin = "0 5 3 5" Click="ButtonDelete_Click" />
                <Button Content="Close" Margin = "0 5 3 5" Click="ButtonClose_Click" />
            </StackPanel>
            <ScrollViewer DockPanel.Dock="Top">
                <toolkit:DataGrid x:Name="TheGrid" ItemsSource="{Binding CurrentConfig.Properties}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <toolkit:DataGrid.Columns>
                        <toolkit:DataGridTextColumn Header="Key" MinWidth="150" Width="SizeToCells" IsReadOnly="False" Binding="{Binding Key}" />
                        <toolkit:DataGridTextColumn Header="Value" MinWidth="150" Width="SizeToCells" IsReadOnly="False" Binding="{Binding Value}" />
                    </toolkit:DataGrid.Columns>
                </toolkit:DataGrid>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>
