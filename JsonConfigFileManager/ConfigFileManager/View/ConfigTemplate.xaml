<UserControl x:Class="ConfigFileManager.View.ConfigTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vml = "clr-namespace:ConfigFileManager.VML"
    xmlns:views="clr-namespace:ConfigFileManager.View"
    xmlns:vm="clr-namespace:ConfigFileManager.ViewModel"
    vml:ViewModelLocator.AutoHookedUpViewModel = "True"
    xmlns:toolkit="http://schemas.microsoft.com/wpf/2008/toolkit"
             >
    <Grid>
        <StackPanel x:Name="TheStack">
            <StackPanel Orientation="Horizontal">
                <Button Content="Add" Margin = "0 5 3 5" Click="ButtonAdd_Click" />
                <Button Content="Delete" Margin = "0 5 3 5" Click="ButtonDelete_Click" />
                <Button Content="Import" Margin = "0 5 3 5" Click="ButtonImport_Click" />
            </StackPanel>
            <ScrollViewer DockPanel.Dock="Top">
                <toolkit:DataGrid x:Name="TheGrid" ItemsSource="{Binding CurrentConfigTemplate}" AutoGenerateColumns="False" CanUserAddRows="False">
                    <toolkit:DataGrid.Columns>
                        <toolkit:DataGridTextColumn Header="Template Name" MinWidth="150" Width="SizeToCells" IsReadOnly="False" Binding="{Binding TemplateName}" />
                        <toolkit:DataGridTemplateColumn MinWidth="150" Width="SizeToCells" IsReadOnly="True">
                            <toolkit:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Modify" Click="ButtonModify_Click" Margin = "0 5 3 5" />
                                </DataTemplate>
                            </toolkit:DataGridTemplateColumn.CellTemplate>
                        </toolkit:DataGridTemplateColumn>
                        <toolkit:DataGridTemplateColumn MinWidth="150" Width="SizeToCells" IsReadOnly="True" >
                            <toolkit:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Export" Click="ButtonExport_Click" Margin = "0 5 3 5" />
                                </DataTemplate>
                            </toolkit:DataGridTemplateColumn.CellTemplate>
                        </toolkit:DataGridTemplateColumn>
                    </toolkit:DataGrid.Columns>
                </toolkit:DataGrid>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>
