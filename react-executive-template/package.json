{
  "name": "react-executive-template",
  "version": "0.1.0",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "@crestron/ch5-crcomlib": "^2.17.2",
    "@crestron/ch5-utilities-cli": "^2.0.0",
    "@crestron/ch5-webxpanel": "^2.8.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "build:ch5": "react-scripts build && ch5-cli archive -p react-executive-template -P samplesource=react-executive-template -d build -o dist"
  },
  "devDependencies": {
    "@crestron/ch5-shell-utilities-cli": "^2.17.2"
  },
  "eslintConfig": {
    "extends": ["react-app", "react-app/jest"]
  },
  "jest": {
    "moduleNameMapper": {
      "@crestron/ch5-crcomlib/build_bundles/cjs/cr-com-lib": "<rootDir>/src/__mocks__/crcomlib.ts",
      "@crestron/ch5-webxpanel": "<rootDir>/src/__mocks__/webxpanel.ts"
    }
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
